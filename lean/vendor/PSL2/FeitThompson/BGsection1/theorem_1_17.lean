module

public import FeitThompson.BGsection1.proposition_1_16

open scoped Pointwise commutatorElement IsMulCommutative

public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- The focal subgroup of `H`, generated by differences of `G`-conjugate elements of `H`. -/
@[expose]
public def cfsgFocalSubgroup (H : Subgroup G) : Subgroup G :=
  closure {z : G | ∃ x ∈ H, ∃ y ∈ H, IsConj x y ∧ z = x⁻¹ * y}

public theorem cfsgFocalSubgroup_def (H : Subgroup G) :
    cfsgFocalSubgroup H = closure {z : G | ∃ x ∈ H, ∃ y ∈ H, IsConj x y ∧ z = x⁻¹ * y} :=
  rfl

/-- The focal subgroup is contained in the ambient subgroup. -/
public lemma cfsgFocalSubgroup_le (H : Subgroup G) : cfsgFocalSubgroup H ≤ H := by
  rw [cfsgFocalSubgroup_def, closure_le]
  rintro z ⟨x, hx, y, hy, -, rfl⟩
  exact H.mul_mem (H.inv_mem hx) hy

/-- The focal subgroup as a subgroup of `H`. -/
@[expose]
public def cfsgFocalSubgroupOf (H : Subgroup G) : Subgroup H :=
  (cfsgFocalSubgroup H).subgroupOf H

public theorem cfsgFocalSubgroupOf_def (H : Subgroup G) :
    cfsgFocalSubgroupOf H = (cfsgFocalSubgroup H).subgroupOf H :=
  rfl

@[simp] public theorem map_cfsgFocalSubgroupOf (H : Subgroup G) :
    H.cfsgFocalSubgroupOf.map H.subtype = H.cfsgFocalSubgroup :=
  map_subgroupOf_eq_of_le (cfsgFocalSubgroup_le H)

/-- The focal subgroup is normal in the ambient subgroup. -/
public instance instNormalFocalSubgroupOf (H : Subgroup G) : Normal (cfsgFocalSubgroupOf H) := by
  rw [cfsgFocalSubgroupOf_def, normal_subgroupOf_iff (cfsgFocalSubgroup_le H)]
  intro n g hn hg
  induction hn using closure_induction with
  | mem z hz =>
      rcases hz with ⟨x, hx, y, hy, hxy, rfl⟩
      refine subset_closure ?_
      refine ⟨g * x * g⁻¹, ?_, g * y * g⁻¹, ?_, ?_, ?_⟩
      · exact H.mul_mem (H.mul_mem hg hx) (H.inv_mem hg)
      · exact H.mul_mem (H.mul_mem hg hy) (H.inv_mem hg)
      · rcases isConj_iff.mp hxy with ⟨u, hu⟩
        refine isConj_iff.mpr ⟨g * u * g⁻¹, ?_⟩
        calc
          (g * u * g⁻¹) * (g * x * g⁻¹) * (g * u * g⁻¹)⁻¹
              = g * (u * x * u⁻¹) * g⁻¹ := by simp [mul_assoc]
          _ = g * y * g⁻¹ := by rw [hu]
      · rcases isConj_iff.mp hxy with ⟨u, hu⟩
        simp [mul_assoc]
  | one =>
      simp
  | mul a b _ _ ha hb =>
      simpa [mul_assoc] using mul_mem ha hb
  | inv a _ ha =>
      simpa [mul_assoc] using inv_mem ha

/-- The focal subgroup lies in the commutator subgroup. -/
public lemma cfsgFocalSubgroup_le_commutator (H : Subgroup G) : cfsgFocalSubgroup H ≤ _root_.commutator G := by
  rw [cfsgFocalSubgroup_def, closure_le]
  rintro z ⟨x, hx, y, hy, hxy, rfl⟩
  rcases isConj_iff.mp hxy with ⟨u, rfl⟩
  have hcomm : ⁅x⁻¹, u⁆ ∈ _root_.commutator G :=
    commutator_mem_commutator (mem_top (x⁻¹)) (mem_top u)
  rw [SetLike.mem_coe]
  simpa only [commutatorElement_def, inv_inv, mul_assoc] using hcomm

/-- The commutator subgroup of `H` lies in its focal subgroup. -/
public lemma commutator_le_cfsgFocalSubgroupOf (H : Subgroup G) : _root_.commutator H ≤ cfsgFocalSubgroupOf H := by
  rw [_root_.commutator_eq_closure H, commutatorSet_def]
  rw [Subgroup.closure_le]
  rintro z ⟨a, b, rfl⟩
  change (((⁅a, b⁆ : H) : G) ∈ H.cfsgFocalSubgroup)
  refine subset_closure ?_
  refine ⟨((a : H) : G)⁻¹, H.inv_mem a.2, ((b : H) : G) * ((a : H) : G)⁻¹ * ((b : H) : G)⁻¹,
    ?_, ?_, ?_⟩
  · exact H.mul_mem (H.mul_mem b.2 (H.inv_mem a.2)) (H.inv_mem b.2)
  · refine isConj_iff.mpr ⟨(b : H), ?_⟩
    simp [mul_assoc]
  · simp [commutatorElement_def, mul_assoc]

public instance instIsMulCommutativeQuotientFocalSubgroupOf (H : Subgroup G) :
    IsMulCommutative (H ⧸ cfsgFocalSubgroupOf H) :=
  Normal.quotient_commutative_iff_commutator_le.mpr
    (commutator_le_cfsgFocalSubgroupOf H)

/-- In `H/H*`, conjugate elements of `H` have the same class. -/
public lemma cfsgFocalSubgroupOf.mk'_conj_eq (H : Subgroup G) {h : G} (hh : h ∈ H) (g : G)
    (hconj : g⁻¹ * h * g ∈ H) :
    (QuotientGroup.mk' (cfsgFocalSubgroupOf H)) ⟨g⁻¹ * h * g, hconj⟩ =
      (QuotientGroup.mk' (cfsgFocalSubgroupOf H)) ⟨h, hh⟩ := by
  apply QuotientGroup.eq.mpr
  rw [cfsgFocalSubgroupOf_def, mem_subgroupOf]
  refine subset_closure ?_
  refine ⟨g⁻¹ * h * g, hconj, h, hh, ?_, ?_⟩
  · exact isConj_iff.mpr ⟨g, by simp [mul_assoc]⟩
  · simp

/-- The transfer homomorphism `G → H/H*`. -/
@[expose]
public noncomputable def cfsgTransferFocal (H : Subgroup G) [H.FiniteIndex] :
    G →* H ⧸ cfsgFocalSubgroupOf H :=
  MonoidHom.transfer (QuotientGroup.mk' (cfsgFocalSubgroupOf H))

/-- The transfer map restricts to the power map modulo the focal subgroup. -/
public theorem cfsgTransferFocal_eq_pow (H : Subgroup G) [H.FiniteIndex] (x : H) :
    cfsgTransferFocal H x = (x : H ⧸ H.cfsgFocalSubgroupOf) ^ H.index := by
  have : Fintype (Quotient (MulAction.orbitRel (zpowers (x : G)) (G ⧸ H))) :=
    Fintype.ofFinite _
  rw [cfsgTransferFocal, index_eq_sum_minimalPeriod H x, ← Finset.prod_pow_eq_pow_sum,
    MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot]
  apply Finset.prod_congr rfl
  intros
  apply cfsgFocalSubgroupOf.mk'_conj_eq H

variable {p : ℕ} [Fact p.Prime] [Finite G] [Finite (Sylow p G)]

omit [Finite (Sylow p G)] in
/-- The kernel of the restricted focal transfer is the focal subgroup. -/
public lemma ker_restrict_cfsgTransferFocal_eq_cfsgFocalSubgroupOf (P : Sylow p G) :
    (((P : Subgroup G).cfsgTransferFocal).domRestrict (P : Subgroup G)).ker =
      (P : Subgroup G).cfsgFocalSubgroupOf := by
  let : (P : Subgroup G).FiniteIndex := Subgroup.finiteIndex_of_finite
  ext g
  have hQ : IsPGroup p ((P : Subgroup G) ⧸ (P : Subgroup G).cfsgFocalSubgroupOf) :=
    P.2.to_quotient ((P : Subgroup G).cfsgFocalSubgroupOf)
  rw [MonoidHom.mem_ker, MonoidHom.domRestrict_apply, cfsgTransferFocal_eq_pow]
  simpa using (hQ.powEquiv' P.not_dvd_index).apply_eq_iff_eq (x := g) (y := 1)

omit [Finite (Sylow p G)] in
public lemma ker_cfsgTransferFocal_inf_eq_cfsgFocalSubgroup (P : Sylow p G) :
    ((P : Subgroup G).cfsgTransferFocal).ker ⊓ (P : Subgroup G) = (P : Subgroup G).cfsgFocalSubgroup := by
  let : (P : Subgroup G).FiniteIndex := Subgroup.finiteIndex_of_finite
  rw [← subgroupOf_map_subtype, ← MonoidHom.ker_domRestrict, ← map_cfsgFocalSubgroupOf]
  exact congrArg (fun K : Subgroup (P : Subgroup G) => K.map (P : Subgroup G).subtype)
    (ker_restrict_cfsgTransferFocal_eq_cfsgFocalSubgroupOf P)

omit [Finite (Sylow p G)] in
/-- The focal subgroup theorem for a Sylow subgroup. -/
public theorem commutator_inf_eq_cfsgFocalSubgroup (P : Sylow p G) :
    _root_.commutator G ⊓ (P : Subgroup G) = (P : Subgroup G).cfsgFocalSubgroup := by
  let : (P : Subgroup G).FiniteIndex := Subgroup.finiteIndex_of_finite
  apply le_antisymm
  · apply le_trans ?_ (ker_cfsgTransferFocal_inf_eq_cfsgFocalSubgroup P).le
    exact inf_le_inf_right _ (Abelianization.commutator_subset_ker ((P : Subgroup G).cfsgTransferFocal))
  · exact le_inf ((P : Subgroup G).cfsgFocalSubgroup_le_commutator) ((P : Subgroup G).cfsgFocalSubgroup_le)

end Subgroup

/-
**Kind**: Theorem
**Note**: Theorem 1.17
**Stmt**:
Let `G` be a finite group.
Let `p` be a prime.
Let `S` be a Sylow `p`-subgroup of `G`.
Then
`S ∩ G' = ⟨ x⁻¹ y | x, y ∈ S and x is conjugate to y in G ⟩`.
-/

public theorem theorem_1_17 {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime] (S : Sylow p G) :
    ((S : Subgroup G) ⊓ derivedSubgroup G) =
      Subgroup.closure {z : G | ∃ x : G, x ∈ (S : Subgroup G) ∧ ∃ y : G, y ∈ (S : Subgroup G) ∧
        IsConj x y ∧ z = x⁻¹ * y} := by
  simpa using sylow_inf_derivedSubgroup_eq_focalSubgroup (G := G) p S


end
